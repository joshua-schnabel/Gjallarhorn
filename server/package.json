{
  "name": "doorbell-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "comment": "Node 24 runs TypeScript directly, so there is no build step. tsc is used only to typecheck.",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.33",
    "fastify": "^5.2.1",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.11",
    "typescript": "^5.7.3"
  }
}
