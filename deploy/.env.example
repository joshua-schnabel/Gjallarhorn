# Copy to .env and fill in. Never commit .env — it is git-ignored.
# Names and descriptions only below; no real values.

# ---------------------------------------------------------------------------
# Required. The backend refuses to start without these.
# ---------------------------------------------------------------------------

# Hostname the tablet and the door device use to reach this server.
# The TLS certificate is issued for exactly this name, so it must match what
# clients type. DNS must resolve it on the LAN.
# No default is possible, and guessing would move the failure onto the tablet.
PUBLIC_HOSTNAME=

# MQTT broker. In production this is the existing broker on the network.
# With `--profile dev` it is the bundled container, reachable as `mosquitto`.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# Host port for HTTPS. The container always listens on 8443 internally.
HTTP_PORT=8443

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------

# Leave both empty to have the backend generate a local CA and a server
# certificate on first start, and serve the CA certificate for installation on
# the tablet. Set them to use your own CA or a Let's Encrypt certificate.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Where the tablet fetches the CA certificate during onboarding.
TLS_CA_DOWNLOAD_PATH=/ca.crt

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

DATA_DIR=/data
SNAPSHOT_DIR=/data/snapshots

# Upload limit for a single snapshot, in bytes.
SNAPSHOT_MAX_BYTES=2097152

# Storage is finite and long-term recording is out of scope.
SNAPSHOT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Suppresses republishing of repeated motion events. This protects the event
# history from duplicates. It does NOT protect the battery — by the time a
# request arrives the energy is already spent. The battery-protecting cooldown
# is the PIR's hold time; see docs/architecture.md section 6.
MOTION_COOLDOWN_MS=60000

# No contact for longer than this and the device state becomes `unreachable`.
# Must be comfortably longer than the longest expected quiet period, or a
# healthy sleeping doorbell will be reported as broken.
DEVICE_STALE_AFTER_MS=1800000

# ---------------------------------------------------------------------------
# MQTT topics
# ---------------------------------------------------------------------------

# Root of the topic tree. Also the escape hatch for breaking schema changes:
# publish a new schema under a different base topic and migrate consumers at
# their own pace. See docs/mqtt.md.
MQTT_BASE_TOPIC=doorbell

# Ceiling for reconnect backoff. Bounded on purpose — an unbounded reconnect
# storm against a broker that is down is the failure mode to avoid.
MQTT_RECONNECT_MAX_MS=60000

# ---------------------------------------------------------------------------
# Pairing
# ---------------------------------------------------------------------------

# One-time code a tablet exchanges for a client token at POST /auth/pair.
# Rotate it after pairing. Rate limited and single use.
PAIRING_CODE=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# trace | debug | info | warn | error
LOG_LEVEL=info
