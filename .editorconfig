# Shared editor settings. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{c,h,cpp,hpp}]
indent_size = 4

[*.{js,ts,tsx,json,jsonc,yml,yaml,html,css}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[CMakeLists.txt]
indent_size = 4
